# Cloudflare Pages response headers. scripts/csp.mjs fills in the hashes after every build;
# until it has run, the placeholders make the policy block every inline script and style.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' __SCRIPT_HASHES__; style-src 'self' 'unsafe-hashes' __STYLE_HASHES__; img-src 'self' data:; font-src 'self'; connect-src 'self'; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

# ReDoc injects its styles at runtime, which no hash can cover, and runs its search in a worker it
# builds from a blob: URL, so the API reference swaps in a policy that allows both. Scripts stay
# hash-only, the same as everywhere else.
/api-reference/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' __SCRIPT_HASHES__; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests

# The radio player streams audio from, and reads the now-playing feed of, the station host, and nothing
# else on the site may. Scripts and styles stay hash-only, the same as everywhere else. The radio host
# serves these pages from /radio/ (see functions/_middleware.js), so this is the policy it gets.
/radio/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' __SCRIPT_HASHES__; style-src 'self' 'unsafe-hashes' __STYLE_HASHES__; img-src 'self' data: https://stream.audiobookmanager.com; media-src https://stream.audiobookmanager.com; connect-src 'self' https://stream.audiobookmanager.com; font-src 'self'; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests
