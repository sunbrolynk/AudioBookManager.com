---
import { Icon } from '@astrojs/starlight/components';
import strings from '../ui-strings.json';

interface Props { locale?: string }
const t = (strings as Record<string, Record<string, string>>)[Astro.props.locale ?? 'en'];
---
<dialog id="lightbox" class="lb" aria-label={t.screenshots}>
  <button type="button" class="lb-x" aria-label={t.prereleaseDismiss}><Icon name="close" size="1.5rem" /></button>
  <img alt="" />
</dialog>

<script>
  // Screenshots open full size in a dialog: a click or Enter/Space on the image, closed by Esc, the button or the backdrop.
  const dialog = document.getElementById('lightbox');
  if (dialog instanceof HTMLDialogElement) {
    const big = dialog.querySelector('img') as HTMLImageElement;
    let back: HTMLElement | null = null;
    const open = (img: HTMLImageElement) => {
      back = img;
      big.src = img.currentSrc || img.src;
      big.alt = img.alt;
      dialog.showModal();
    };
    dialog.addEventListener('close', () => { big.removeAttribute('src'); back?.focus(); });
    dialog.addEventListener('click', (e) => { if (e.target !== big) dialog.close(); });
    document.querySelectorAll<HTMLImageElement>('.sl-markdown-content img[src*="/_astro/"], .crop img, .stage img').forEach((img) => {
      img.tabIndex = 0;
      img.setAttribute('role', 'button');
      img.setAttribute('aria-haspopup', 'dialog');
      img.classList.add('lb-zoom');
      img.addEventListener('click', () => open(img));
      img.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); open(img); }
      });
    });
  }
</script>

<style is:global>
  .lb-zoom { cursor: zoom-in; }
  .lb-zoom:focus-visible { outline: 2px solid var(--r1-acc-hi, #a78bfa); outline-offset: 3px; }
</style>
<style>
  .lb { max-width: calc(100vw - 32px); max-height: calc(100dvh - 32px); padding: 0; margin: auto; border: 1px solid #3a3a3a; border-radius: 8px; background: #111; overflow: visible; }
  .lb::backdrop { background: rgba(10,10,10,.88); }
  .lb img { display: block; max-width: calc(100vw - 34px); max-height: calc(100dvh - 34px); width: auto; height: auto; border-radius: 8px; cursor: zoom-out; }
  .lb-x { position: absolute; top: 8px; inset-inline-end: 8px; display: inline-flex; padding: 6px; border: 0; border-radius: 4px; background: rgba(0,0,0,.65); color: #fff; cursor: pointer; }
  .lb-x:focus-visible { outline: 2px solid var(--r1-acc-hi, #a78bfa); outline-offset: 2px; }
</style>
