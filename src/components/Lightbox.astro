---
import { Icon } from '@astrojs/starlight/components';
import strings from '../ui-strings.json';

interface Props { locale?: string }
const t = (strings as Record<string, Record<string, string>>)[Astro.props.locale ?? 'en'];
---
<dialog id="lightbox" class="lb" aria-label={t.screenshots} data-prev={t.slidePrev} data-next={t.slideNext} data-count={t.slideCount} data-group={t.screenshots}>
  <button type="button" class="lb-x" aria-label={t.prereleaseDismiss}><Icon name="close" size="1.5rem" /></button>
  <button type="button" class="lb-n lb-prev" aria-label={t.slidePrev}><Icon name="left-caret" size="1.5rem" /></button>
  <button type="button" class="lb-n lb-next" aria-label={t.slideNext}><Icon name="right-caret" size="1.5rem" /></button>
  <img alt="" />
  <p class="lb-c" aria-live="polite"></p>
</dialog>

<script>
  // Screenshots open full size in a dialog: a click or Enter/Space on the image, closed by Esc, the button or the backdrop.
  // Consecutive screenshots on a page become one slideshow: a swipeable strip, and the same set in the enlarged view.
  const dialog = document.getElementById('lightbox');
  if (dialog instanceof HTMLDialogElement) {
    const big = dialog.querySelector('img') as HTMLImageElement;
    const counter = dialog.querySelector('.lb-c') as HTMLElement;
    const { prev: prevLabel = '', next: nextLabel = '', count: countFmt = '{n} / {total}', group: groupLabel = '' } = dialog.dataset;
    const count = (n: number, total: number) => countFmt.replace('{n}', String(n)).replace('{total}', String(total));
    const calm = () => matchMedia('(prefers-reduced-motion: reduce)').matches;
    const arrow = (cls: string, label: string, dir: string) => {
      const b = document.createElement('button');
      b.type = 'button'; b.className = `ss-n ${cls}`; b.setAttribute('aria-label', label); b.dataset.dir = dir;
      b.innerHTML = '<svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2.5" d="' + (dir === '-1' ? 'M15 5l-7 7 7 7' : 'M9 5l7 7-7 7') + '"/></svg>';
      return b;
    };

    // Group runs of paragraphs that hold nothing but one screenshot.
    const sets = new Map<HTMLImageElement, HTMLImageElement[]>();
    const shot = (el: Element | null) => el instanceof HTMLParagraphElement && el.children.length === 1 && el.firstElementChild instanceof HTMLImageElement && !el.textContent?.trim() ? el : null;
    const seen = new Set<Element>();
    document.querySelectorAll('.sl-markdown-content > p').forEach((p) => {
      if (seen.has(p) || !shot(p)) return;
      const run: HTMLParagraphElement[] = [];
      for (let n: Element | null = p; shot(n); n = n!.nextElementSibling) run.push(n as HTMLParagraphElement);
      run.forEach((r) => seen.add(r));
      if (run.length < 2) return;
      const imgs = run.map((r) => r.firstElementChild as HTMLImageElement);
      const ss = document.createElement('div');
      ss.className = 'ss'; ss.setAttribute('role', 'group'); ss.setAttribute('aria-roledescription', 'carousel'); ss.setAttribute('aria-label', groupLabel);
      p.before(ss);
      const track = document.createElement('div');
      track.className = 'ss-track'; track.tabIndex = 0; track.setAttribute('aria-label', groupLabel);
      const bar = document.createElement('div');
      bar.className = 'ss-bar';
      const dots = document.createElement('span');
      dots.className = 'ss-dots'; dots.setAttribute('aria-hidden', 'true');
      const num = document.createElement('span');
      num.className = 'ss-count'; num.setAttribute('aria-live', 'polite');
      run.forEach((r, i) => {
        r.className = 'ss-slide'; r.setAttribute('role', 'group'); r.setAttribute('aria-roledescription', 'slide');
        r.setAttribute('aria-label', count(i + 1, run.length));
        dots.append(document.createElement('i'));
        track.append(r);
        sets.set(imgs[i], imgs);
      });
      const at = () => Math.min(run.length - 1, Math.max(0, Math.round(track.scrollLeft / track.clientWidth)));
      const mark = () => {
        const i = at();
        dots.querySelectorAll('i').forEach((d, j) => d.classList.toggle('on', j === i));
        num.textContent = count(i + 1, run.length);
      };
      const go = (i: number) => track.scrollTo({ left: Math.min(run.length - 1, Math.max(0, i)) * track.clientWidth, behavior: calm() ? 'auto' : 'smooth' });
      let frame = 0;
      track.addEventListener('scroll', () => { cancelAnimationFrame(frame); frame = requestAnimationFrame(mark); }, { passive: true });
      track.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft') { e.preventDefault(); go(at() - 1); }
        if (e.key === 'ArrowRight') { e.preventDefault(); go(at() + 1); }
      });
      const prev = arrow('ss-prev', prevLabel, '-1');
      const next = arrow('ss-next', nextLabel, '1');
      prev.addEventListener('click', () => go(at() - 1));
      next.addEventListener('click', () => go(at() + 1));
      bar.append(prev, dots, num, next);
      ss.append(track, bar);
      ss.dataset.slides = String(run.length);
      mark();
      (ss as any).goTo = go;
    });

    let back: HTMLElement | null = null;
    let list: HTMLImageElement[] = [];
    let at = 0;
    const show = (i: number) => {
      at = (i + list.length) % list.length;
      const img = list[at];
      big.src = img.currentSrc || img.src;
      big.alt = img.alt;
      counter.textContent = list.length > 1 ? count(at + 1, list.length) : '';
      back = img;
    };
    const open = (img: HTMLImageElement) => {
      list = sets.get(img) ?? [img];
      dialog.classList.toggle('lb-solo', list.length < 2);
      show(list.indexOf(img));
      dialog.showModal();
    };
    const step = (d: number) => { if (list.length > 1) show(at + d); };
    dialog.addEventListener('close', () => {
      big.removeAttribute('src');
      // Park the page strip on the slide that was last viewed.
      const ss = back?.closest('.ss') as (HTMLElement & { goTo?: (i: number) => void }) | null;
      ss?.goTo?.(list.indexOf(back as HTMLImageElement));
      back?.focus({ preventScroll: false });
    });
    dialog.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('.lb-n');
      if (btn) return step(btn.classList.contains('lb-prev') ? -1 : 1);
      if (e.target !== big) dialog.close();
    });
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') { e.preventDefault(); step(-1); }
      else if (e.key === 'ArrowRight') { e.preventDefault(); step(1); }
      else if (e.key === 'Tab') {
        // Keep Tab inside the dialog.
        const f = [...dialog.querySelectorAll<HTMLElement>('button')].filter((b) => b.offsetParent !== null);
        const i = f.indexOf(document.activeElement as HTMLElement);
        e.preventDefault();
        f[(i + (e.shiftKey ? -1 : 1) + f.length) % f.length].focus();
      }
    });
    let x0 = 0;
    dialog.addEventListener('touchstart', (e) => { x0 = e.changedTouches[0].clientX; }, { passive: true });
    dialog.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - x0;
      if (Math.abs(dx) > 50) { step(dx < 0 ? 1 : -1); e.preventDefault(); }
    });
    document.querySelectorAll<HTMLImageElement>('.sl-markdown-content img[src*="/_astro/"], .crop img, .stage img, .sc-view img, .phone-f img').forEach((img) => {
      img.tabIndex = 0;
      img.setAttribute('role', 'button');
      img.setAttribute('aria-haspopup', 'dialog');
      img.classList.add('lb-zoom');
      img.addEventListener('click', () => open(img));
      img.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); open(img); }
      });
    });
  }
</script>

<style is:global>
  .lb-zoom { cursor: zoom-in; }
  .lb-zoom:focus-visible { outline: 2px solid var(--r1-acc-hi, #a78bfa); outline-offset: 3px; }
  .ss { margin: 1.5rem 0; }
  .ss-track { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; border: 1px solid var(--sl-color-hairline, #3a3a3a); border-radius: 8px; background: var(--sl-color-bg-nav, transparent); }
  .ss-track::-webkit-scrollbar { display: none; }
  .ss-track:focus-visible { outline: 2px solid var(--r1-acc-hi, #a78bfa); outline-offset: 3px; }
  .ss-slide { flex: 0 0 100%; scroll-snap-align: center; margin: 0 !important; padding: 0.75rem; display: flex; justify-content: center; align-items: center; box-sizing: border-box; }
  .ss-slide img { max-width: 100%; max-height: 34rem; width: auto; height: auto; margin: 0; border-radius: 6px; }
  .ss-bar { display: flex; align-items: center; justify-content: center; gap: 0.75rem; margin-top: 0.5rem; color: var(--sl-color-gray-2, inherit); font-size: 0.875rem; }
  .ss-n { display: inline-flex; padding: 6px; border: 1px solid var(--sl-color-hairline, #3a3a3a); border-radius: 4px; background: transparent; color: inherit; cursor: pointer; }
  .ss-n:hover { border-color: var(--r1-acc-hi, #a78bfa); }
  .ss-n:focus-visible { outline: 2px solid var(--r1-acc-hi, #a78bfa); outline-offset: 2px; }
  .ss-bar > *, .ss-dots i { margin: 0 !important; }
  .ss-dots { display: inline-flex; align-items: center; gap: 6px; }
  .ss-dots i { width: 8px; height: 8px; border-radius: 50%; background: var(--sl-color-gray-4, #555); }
  .ss-dots i.on { background: var(--r1-acc-hi, #a78bfa); }
  .ss-count { min-width: 4.5em; text-align: center; font-variant-numeric: tabular-nums; }
  @media (prefers-reduced-motion: no-preference) { .ss-track { scroll-behavior: smooth; } }
</style>
<style>
  .lb { max-width: calc(100vw - 32px); max-height: calc(100dvh - 32px); padding: 0; margin: auto; border: 1px solid #3a3a3a; border-radius: 8px; background: #111; overflow: visible; }
  .lb::backdrop { background: rgba(10,10,10,.88); }
  .lb img { display: block; max-width: calc(100vw - 34px); max-height: calc(100dvh - 34px); width: auto; height: auto; border-radius: 8px; cursor: zoom-out; }
  .lb-x { position: absolute; top: 8px; inset-inline-end: 8px; display: inline-flex; padding: 6px; border: 0; border-radius: 4px; background: rgba(0,0,0,.65); color: #fff; cursor: pointer; }
  .lb-n { position: absolute; top: 50%; translate: 0 -50%; display: inline-flex; padding: 10px 6px; border: 0; border-radius: 4px; background: rgba(0,0,0,.65); color: #fff; cursor: pointer; }
  .lb-prev { inset-inline-start: 8px; }
  .lb-next { inset-inline-end: 8px; }
  .lb-solo .lb-n, .lb-solo .lb-c { display: none; }
  .lb-c { position: absolute; bottom: 8px; left: 50%; translate: -50% 0; margin: 0; padding: 2px 10px; border-radius: 99px; background: rgba(0,0,0,.65); color: #fff; font-size: 0.875rem; font-variant-numeric: tabular-nums; }
  .lb-n:focus-visible, .lb-x:focus-visible { outline: 2px solid var(--r1-acc-hi, #a78bfa); outline-offset: 2px; }
</style>
