---
import RadioLayout from '../../layouts/RadioLayout.astro';
import { STREAM_HOST } from '../../lib/radio.mjs';

const aac = `${STREAM_HOST}/listen/lofi/radio.aac`;
const mp3 = `${STREAM_HOST}/listen/lofi/radio.mp3`;
// <wbr> lets the long stream address wrap on a narrow screen without changing the text that gets copied.
const breakable = (url: string) => url.split('/').join('/<wbr>');
const streams = [
  { fmt: 'AAC', url: aac, note: 'best sound, works almost everywhere' },
  { fmt: 'MP3', url: mp3, note: 'for older players' },
];
const chevron = 'M9 5l7 7-7 7';
---
<RadioLayout
  title="ABM Radio: free lofi for sorting your audiobooks"
  description="Free internet radio from AudioBook Manager. No ads, no accounts, no tracking. Every track on air is openly licensed and credited."
  path="/"
>
  <main class="wrap">
    <section class="hero he">
      <p class="mono kick">ABM Radio</p>
      <h1>Lofi from the tower window</h1>
      <p class="lede">Free internet radio from AudioBook Manager. No ads, no accounts, no tracking: press play and leave it running while you sort your library, read, or work.</p>
    </section>
    <div class="np">
      <div class="tower">
        <div class="tframe"><i class="key" aria-hidden="true"></i>
          <div class="glass">
            <div class="vault" aria-hidden="true"><div class="stars s1"></div><div class="stars s2"></div><div class="moon"></div>
              <svg class="orb" viewBox="0 0 600 220" preserveAspectRatio="xMidYMax meet"><ellipse cx="300" cy="200" rx="270" ry="70"/><ellipse cx="300" cy="200" rx="170" ry="44"/><ellipse cx="300" cy="200" rx="80" ry="22"/></svg>
              <svg class="cl" viewBox="0 0 100 100" preserveAspectRatio="none"><line x1="25" y1="68" x2="73" y2="42" vector-effect="non-scaling-stroke"/></svg>
              <i class="pt on" style="left:25%;top:68%"></i><i class="pt" style="left:73%;top:42%"></i>
              <i class="mu v"></i><i class="mu h1"></i><i class="mu h2"></i>
            </div>
            <nav class="map" aria-label="Stations">
              <a class="star on" aria-current="page" href="./" style="left:25%;top:68%"><b></b><span>I &middot; ABM Lofi</span></a>
              <span class="star soon" style="left:73%;top:42%"><b></b><span>II &middot; Story Time</span><em>later</em></span>
            </nav>
          </div>
        </div>
        <div class="sill" aria-hidden="true"></div>
      </div>
      <nav class="chips" aria-label="Stations"><a class="chip on" href="./" aria-current="page">ABM Lofi</a><span class="chip soon">Story Time <em>later</em></span></nav>
      <section class="folio" aria-label="Player">
        <span class="cn tl"></span><span class="cn tr"></span><span class="cn bl"></span><span class="cn br"></span>
        <p class="mono live"><span class="dot"></span> <span data-b="live">Live</span><span data-b="listeners"></span></p>
        <div class="lead">
          <div class="plate"><div class="cv fade" data-b="cover" role="img" aria-label="Cover art"></div></div>
          <div>
            <h2 class="title fade" data-b="title">ABM Lofi</h2>
            <p class="artist fade"><span data-b="artist"></span><span class="al" data-b="album"></span></p>
            <p class="credit fade" data-b="creditline" hidden><span data-b="credit"></span> &middot; <a data-b="source">source</a></p>
          </div>
        </div>
        <div class="bar fade" aria-hidden="true"><i data-b="progress"></i></div>
        <p class="times mono" aria-hidden="true"><span data-b="elapsed"></span><span data-b="duration"></span></p>
        <div class="ctl">
          <button class="go" type="button" data-b="play" aria-label="Play"><svg class="ic play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg><svg class="ic stop" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6h12v12H6z"/></svg></button>
          <label class="vol"><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9v6h4l5 4V5L8 9z"/><path d="M16 8.5a5 5 0 0 1 0 7" fill="none" stroke="currentColor" stroke-width="2"/></svg><span class="sr">Volume</span><input type="range" min="0" max="100" value="70" data-b="volume"></label>
          <button class="mute" type="button" data-b="mute" aria-pressed="false" aria-label="Mute"><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9v6h4l5 4V5L8 9z"/><path class="x" d="M16 9l5 6M21 9l-5 6" fill="none" stroke="currentColor" stroke-width="2"/></svg></button>
        </div>
        <p class="notice rc"><span data-b="retry">Reconnecting…</span></p>
        <p class="notice dn">Can&rsquo;t reach the now-playing feed. Audio keeps playing; this is the last track I saw.</p>
        <p class="mono stat" data-b="status" role="status">Press play to tune in</p>
        <noscript><p class="notice show">This player needs JavaScript. Without it, use the stream links below in any audio app, or play it here: <audio controls preload="none"><source src={aac} type="audio/aac"><source src={mp3} type="audio/mpeg"></audio></p></noscript>
      </section>
    </div>
    <section class="cols">
      <div class="log">
        <h2>Quest log</h2><p class="mono sub">Recently played</p>
        <p class="next"><span class="mono">Up next</span> <span data-b="next">Nothing queued yet</span></p>
        <ul class="hist fade" data-b="history"></ul>
      </div>
      <div class="prose">
        <details class="grp g1" open><summary><h2>About this station</h2><svg class="chev" viewBox="0 0 24 24" aria-hidden="true"><path d={chevron} fill="none" stroke="currentColor" stroke-width="2.4"/></svg></summary>
          <div class="gb"><p>ABM Lofi plays music its artists have released under open licences, mostly Creative Commons Attribution, and nothing else. I check each track&rsquo;s licence when I add it, save a copy of the page that grants it, and keep the whole catalog public in the <a href="https://github.com/sunbrolynk/abm-radio" rel="noopener">abm-radio repo</a>. The <a href="credits/">credits page</a> lists every track that can play and who made it.</p><p class="more"><a href="credits/">Read the credits &rarr;</a></p></div></details>
        <details class="grp g2" open><summary><h2>Listen anywhere</h2><svg class="chev" viewBox="0 0 24 24" aria-hidden="true"><path d={chevron} fill="none" stroke="currentColor" stroke-width="2.4"/></svg></summary>
          <div class="gb"><p>The player works in any browser. To use your own app (VLC, a phone radio app, a smart speaker), add one of these:</p>
            <ul class="urls">
              {streams.map((s) => (
                <li data-url={s.url}><i class="fmt">{s.fmt}</i><code set:html={breakable(s.url)} /> <span>{s.note}</span><button class="copy" type="button" aria-label={`Copy ${s.fmt} stream link`}><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 9h10v12H9zM5 3h10v4H7v8H5z"/></svg></button></li>
              ))}
            </ul>
          </div></details>
        <details class="grp g5" open><summary><h2>Coming soon</h2><svg class="chev" viewBox="0 0 24 24" aria-hidden="true"><path d={chevron} fill="none" stroke="currentColor" stroke-width="2.4"/></svg></summary>
          <div class="gb"><p>More stations are on the way. Same rules as ABM Lofi: free, no accounts, and everything on air is openly licensed and credited.</p>
            <ul class="soonlist">
              <li><b>Story Time:</b> public-domain stories read aloud, between the music.</li>
              <li><b>Lil&rsquo; Beats FM:</b> for kids. Upbeat, kid-safe music with story-time shows of public-domain stories.</li>
              <li><b>Velvet Static:</b> for grown-ups. Chill downtempo and trip-hop, with late-night mystery, sci-fi and horror story shows.</li>
            </ul></div></details>
      </div>
    </section>
    <section class="cols b">
      <div class="prose"><details class="grp g3" open><summary><h2>Artists</h2><svg class="chev" viewBox="0 0 24 24" aria-hidden="true"><path d={chevron} fill="none" stroke="currentColor" stroke-width="2.4"/></svg></summary>
        <div class="gb"><p>If you&rsquo;re an artist and want a track taken off the air, email <a href="mailto:admin@audiobookmanager.com">admin@audiobookmanager.com</a> and I&rsquo;ll remove it. If you&rsquo;d like your music played here, the same address works.</p></div></details></div>
      <div class="prose"><details class="grp g4" open><summary><h2>Privacy</h2><svg class="chev" viewBox="0 0 24 24" aria-hidden="true"><path d={chevron} fill="none" stroke="currentColor" stroke-width="2.4"/></svg></summary>
        <div class="gb"><p>This page uses no cookies, analytics or third-party scripts. The streaming server sees your IP address while you listen, like any website does. It keeps only listener totals, not who listened, and its logs are cleared after about a week.</p></div></details></div>
    </section>
  </main>
  <div slot="after">
    <div class="mini" role="region" aria-label="Now playing"><div class="cv fade" data-b="cover" aria-hidden="true"></div><div class="mt"><b class="t fade" data-b="title"></b><span class="a fade" data-b="artist"></span></div><button class="go" type="button" data-b="play" aria-label="Play"><svg class="ic play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg><svg class="ic stop" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6h12v12H6z"/></svg></button></div>
    <div class="toast" role="status" aria-live="polite"></div>
  </div>
  <script>
    import '../../scripts/radio';
  </script>
</RadioLayout>
